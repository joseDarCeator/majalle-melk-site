---
import { articles } from "../data/articles.js";

const featuredArticle = articles.find((article) => article.featured);
const otherArticles = articles.filter((article) => !article.featured);
---

<!doctype html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>مقالات بازار ملک مشهد | مجله ملک</title>
  <meta name="description" content="راهنماها و مقالات خرید ملک و سرمایه‌گذاری در مشهد." />
</head>
<body>
  <header>
    <a href="/">مجله ملک <span>| مشهد</span></a>
    <nav>
      <a href="/">خانه</a>
      <a href="/articles">مقالات</a>
      <a href="/investment">سرمایه‌گذاری</a>
      <a href="/about">درباره ما</a>
    </nav>
  </header>

  <main>
    <section class="intro">
      <span class="eyebrow">دانش بازار ملک</span>
      <h1>مقالات مجله ملک</h1>
      <p>راهنماها و مطالب کاربردی درباره خرید ملک و سرمایه‌گذاری در مشهد.</p>
    </section>

    {featuredArticle && (
      <section class="featured">
        <span class="eyebrow">مقاله ویژه · {featuredArticle.category}</span>
        <h2>{featuredArticle.title}</h2>
        <p>{featuredArticle.excerpt}</p>
        <a class="button" href={`/articles/${featuredArticle.slug}`}>مطالعه مقاله ←</a>
      </section>
    )}

    <section class="listing">
      <h2>تازه‌ترین مقالات</h2>
      <div class="grid">
        {otherArticles.map((article) => (
          <article class="card">
            <span class="eyebrow">{article.category}</span>
            <h3>{article.title}</h3>
            <p>{article.excerpt}</p>
            <div class="meta">
              <span>{article.readTime} دقیقه مطالعه</span>
              <a href={`/articles/${article.slug}`}>ادامه مطلب ←</a>
            </div>
          </article>
        ))}
      </div>
    </section>
  </main>

  <footer>
    <a href="/">مجله ملک | مشهد</a>
    <p>مجله‌ای برای شناخت بهتر بازار ملک مشهد.</p>
    <small>© مجله ملک · تمامی حقوق محفوظ است.</small>
  </footer>
</body>
</html>

<style>
  * { box-sizing: border-box; }

  :global(body) {
    margin: 0;
    background: #183451;
    color: #F3ECDE;
    font-family: Tahoma, Arial, sans-serif;
    line-height: 1.9;
  }

  a { color: inherit; text-decoration: none; }

  header {
    padding: 22px 6%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 20px;
    border-bottom: 1px solid #ffffff25;
  }

  header > a, footer > a { font-size: 1.2rem; font-weight: bold; }
  header span { color: #D4AF83; }

  nav { display: flex; flex-wrap: wrap; gap: 22px; }
  nav a:hover, .meta a:hover { color: #D4AF83; }

  main { max-width: 1150px; width: 88%; margin: auto; }

  .intro { padding: 65px 0 35px; }
  .eyebrow { color: #D4AF83; font-size: .9rem; }
  h1 { font-size: clamp(2rem, 5vw, 3.2rem); margin: 8px 0; }
  .intro p, .featured p, .card p { color: #F3ECDEBB; }

  .featured {
    padding: clamp(24px, 5vw, 48px);
    background: #203F5B;
    border: 1px solid #ffffff20;
    border-radius: 20px;
  }

  .featured h2 { font-size: clamp(1.5rem, 3vw, 2.2rem); }
  .button {
    display: inline-block;
    margin-top: 12px;
    padding: 10px 20px;
    border-radius: 8px;
    background: #A9501C;
  }

  .listing { padding: 60px 0 80px; }
  .listing > h2 { font-size: 1.8rem; }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }

  .card {
    padding: 24px;
    background: #203F5B;
    border: 1px solid #ffffff20;
    border-radius: 16px;
  }

  .card h3 { color: #D4AF83; line-height: 1.8; }
  .meta {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    padding-top: 16px;
    border-top: 1px solid #ffffff20;
    font-size: .85rem;
  }

  .meta a { color: #D4AF83; }
  footer {
    padding: 30px 6%;
    text-align: center;
    border-top: 1px solid #ffffff25;
  }

  footer p, footer small { color: #F3ECDEAA; }

  a:focus-visible { outline: 2px solid #D4AF83; outline-offset: 4px; }

  @media (max-width: 650px) {
    header { flex-direction: column; align-items: flex-start; }
    nav { gap: 12px 18px; }
    .grid { grid-template-columns: 1fr; }
    .intro { padding-top: 42px; }
  }
</style>

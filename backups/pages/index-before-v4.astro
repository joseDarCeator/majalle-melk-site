        </div>
      </section>

      <!-- NEIGHBORHOODS -->
      <section class="neighborhoods container">
        <div class="neighborhood-heading">
          <span class="section-label">راهنمای شهر</span>
          <h2>محله‌های مشهد</h2>
          <p>
            شناخت محله، یکی از مهم‌ترین بخش‌های تصمیم‌گیری برای خرید و
            سرمایه‌گذاری در بازار ملک مشهد است.
          </p>
        </div>

        <div class="neighborhood-list">
          {
            neighborhoods.map((neighborhood, index) => (

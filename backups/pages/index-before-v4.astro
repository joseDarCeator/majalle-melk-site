                    <img src={article.image} alt={article.title} />
                  </div>

                  <div class="latest-content">
                    <span class="eyebrow">{article.category}</span>
                    <h3>{article.title}</h3>
                    <p>{article.excerpt}</p>
                    <time>{article.date}</time>
                  </div>
                </article>

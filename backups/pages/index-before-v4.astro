              <h3>سجاد؛ از سبک زندگی تا آینده بازار ملک</h3>
              <p>{articles[0].excerpt}</p>
            </div>
          </article>

          <div class="stories-side">
            {
              articles.slice(1).map((article) => (
                <article class="story-small">
                  <div class="small-image">
                    <span>تصویر</span>

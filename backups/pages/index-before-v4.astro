        <a href="/neighborhoods">محله‌های مشهد</a>
      </nav>

      <a href="/about" class="header-button">
        درباره ما
      </a>

    </div>
</header> 
     <section class="hero container">
        <div class="hero-content">
          <span class="eyebrow">{featuredArticle.category}</span>

          <h1>{featuredArticle.title}</h1>

         
 <p class="hero-excerpt">{featuredArticle.excerpt}</p>

          <div class="article-meta">
            <span>{featuredArticle.date}</span>
            <span>{featuredArticle.readTime}</span>
          </div>

          <a href="/articles/mashhad-investment" class="primary-button">
            مطالعه مقاله
          </a>
        </div>

        <div class="hero-image">
          <img src={featuredArticle.image} alt="تصویر آزمایشی مقاله منتخب" />

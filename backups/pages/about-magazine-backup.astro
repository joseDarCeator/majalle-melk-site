---
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import "../styles/global.css";
---

<!doctype html>
<html lang="fa" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>درباره ما | مجله ملک</title>
    <meta
      name="مجله ملک؛ مجله تخصصی بازار املاک مشهد، با هدف ارائه راهنماها و تحلیل‌هایی برای شناخت بازار ملک و تصمیم‌گیری آگاهانه در خرید و سرمایه‌گذاری."
      content="با مجله ملک، مجله تخصصی بازار املاک مشهد، بیشتر آشنا شوید."
    />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  </head>

  <body>
    <SiteHeader />

    <main>
      <section class="about-hero">
        <div class="container">
          <span class="eyebrow">درباره مجله ملک</span>
          <h1>روایت تازه‌ای از بازار ملک مشهد</h1>
          <p>
            مجله ملک با هدف ارائه اطلاعات، تحلیل‌ها و راهنماهای کاربردی
            درباره بازار املاک مشهد شکل گرفته است.
          </p>
          <a href="/articles" class="primary-button">مطالعه مقالات</a>
        </div>
      </section>

      <section class="about-intro section">
        <div class="container">
          <span class="eyebrow">داستان ما</span>
          <h2>مجله ملک چیست؟</h2>
          <p>
            مجله ملک فضایی برای آشنایی بیشتر با بازار املاک مشهد است؛
            جایی برای دنبال کردن موضوعات مرتبط با خرید ملک، سرمایه‌گذاری،
            شناخت بازار و جنبه‌های مختلف زندگی شهری.
          </p>
        </div>
      </section>

      <section class="about-mission section">
        <div class="container mission-grid">
          <div>
            <span class="eyebrow">هدف ما</span>
            <h2>اطلاعات روشن، تصمیم‌گیری آگاهانه‌تر</h2>
          </div>
          <p>
            تلاش می‌کنیم مطالب حوزه املاک را به زبانی روشن و قابل‌فهم
            ارائه کنیم تا مخاطبان بتوانند با شناخت بهتر موضوعات،
            گزینه‌های پیش روی خود را بررسی کنند.
          </p>
        </div>
      </section>

      <section class="about-values section">
        <div class="container">
          <span class="eyebrow">نگاه ما</span>
          <h2>اصولی که دنبال می‌کنیم</h2>

          <div class="value-grid">
            <article class="value-card">
              <span>۰۱</span>
              <h3>شفافیت</h3>
              <p>ارائه مطالب روشن و قابل‌درک درباره موضوعات ملکی.</p>
            </article>

            <article class="value-card">
              <span>۰۲</span>
              <h3>آگاهی</h3>
              <p>کمک به شناخت بهتر بازار و معیارهای تصمیم‌گیری.</p>
            </article>

            <article class="value-card">
              <span>۰۳</span>
              <h3>تمرکز محلی</h3>
              <p>توجه ویژه به بازار املاک و تحولات شهر مشهد.</p>
            </article>
          </div>
        </div>
      </section>

      <section class="about-cta">
        <div class="container">
          <h2>همراه مجله ملک باشید</h2>
          <p>برای شناخت بهتر بازار ملک مشهد، مقالات ما را دنبال کنید.</p>
          <a href="/articles" class="primary-button">رفتن به بخش مقالات</a>
        </div>
      </section>
    </main>

    <SiteFooter />
  </body>
</html>

<style>
  :global(body) {
    margin: 0;
    background: #183451;
    color: #f3ecde;
    font-family: "Vazirmatn", sans-serif;
  }

  .container {
    width: min(1180px, calc(100% - 48px));
    margin-inline: auto;
  }

  .section {
    padding-block: 90px;
  }

  .about-hero {
    padding-block: 120px 130px;
    background: linear-gradient(135deg, #183451, #244968);
  }

  .about-hero .container {
    max-width: 900px;
  }

  .eyebrow {
    color: #d4af83;
    font-size: 0.85rem;
  }

  h1 {
    max-width: 850px;
    margin: 22px 0;
    font-size: clamp(2rem, 5vw, 3.6rem);
    line-height: 1.8;
  }

  h2 {
    font-size: clamp(1.6rem, 3vw, 2.3rem);
    line-height: 1.8;
  }

  .about-hero p,
  .about-intro p,
  .mission-grid p,
  .about-cta p {
    max-width: 760px;
    color: rgba(243, 236, 222, 0.72);
    font-size: 1.05rem;
    line-height: 2.2;
  }

  .primary-button {
    display: inline-block;
    margin-top: 22px;
    padding: 12px 26px;
    border-radius: 8px;
    background: #a9501c;
    color: #fff;
    text-decoration: none;
    transition: background 0.2s ease;
  }

  .primary-button:hover {
    background: #c16a30;
  }

  .about-intro {
    border-bottom: 1px solid rgba(243, 236, 222, 0.12);
  }

  .about-mission {
    background: rgba(255, 255, 255, 0.025);
  }

  .mission-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 60px;
  }

  .value-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 42px;
  }

  .value-card {
    padding: 30px;
    border: 1px solid rgba(243, 236, 222, 0.14);
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.035);
  }

  .value-card span {
    color: #d4af83;
  }

  .value-card h3 {
    margin: 14px 0 8px;
    font-size: 1.2rem;
  }

  .value-card p {
    color: rgba(243, 236, 222, 0.65);
    line-height: 2;
  }

  .about-cta {
    padding-block: 75px;
    text-align: center;
    background: #203f5c;
  }

  .about-cta p {
    margin-inline: auto;
  }

  @media (max-width: 700px) {
    .about-hero {
      padding-block: 80px;
    }

    .section {
      padding-block: 60px;
    }

    .mission-grid,
    .value-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .value-card {
      padding: 24px;
    }
  }
</style>


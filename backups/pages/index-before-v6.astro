  category: "سرمایه‌گذاری",
  title: "سرمایه‌گذاری در مشهد؛ نگاهی به محله‌هایی که آینده بازار را می‌سازند",
  excerpt:
    "شناخت محله، روند توسعه شهری و درک درست بازار می‌تواند مسیر یک سرمایه‌گذاری مطمئن‌تر در مشهد را روشن کند.",
  date: "۱۲ آبان ۱۴۰۵",
  readTime: "۸ دقیقه مطالعه",
  image: "https://images.unsplash.com/photo-1564013799919-ab600027ffc6?auto=format&fit=crop&w=1600&q=90",
};

const articles = [
  {
    slug: "sajjad-neighborhood-guide",
    category: "تحلیل بازار",
    title: "بازار مسکن مشهد؛ چه چیزهایی را باید زیر نظر داشت؟",
    date: "۱۰ آبان ۱۴۰۵",
    readTime: "۶ دقیقه مطالعه",
    excerpt: "یک محتوای آزمایشی برای بررسی عوامل مهم بازار و دیدن ظاهر کارت‌های مجله در صفحه اصلی.",
    image: "https://images.unsplash.com/photo-1564501049412-61c2a3083791?auto=format&fit=crop&w=1200&q=85",
  },
  {
    slug: "mashhad-housing-market",
    category: "بازار مسکن",
    title: "بازار مسکن مشهد در مسیر جدید؛ چه عواملی اهمیت دارند؟",
    date: "۸ آبان ۱۴۰۵",
    readTime: "۵ دقیقه مطالعه",
    excerpt: "نمونه‌ای آزمایشی برای نمایش یک تحلیل کوتاه و خواندنی از بازار مسکن مشهد.",
    image: "https://images.unsplash.com/photo-1560518883-ce09059eeffa?auto=format&fit=crop&w=1200&q=85",
  },
  {
    slug: "before-buying-a-home-in-mashhad",
    category: "راهنمای خرید",
    title: "پیش از خرید خانه در مشهد به چه نکاتی توجه کنیم؟",
    date: "۵ آبان ۱۴۰۵",
    readTime: "۷ دقیقه مطالعه",
    excerpt: "چند نکته نمونه برای شروع یک تصمیم‌گیری آگاهانه‌تر هنگام خرید خانه.",
    image: "https://images.unsplash.com/photo-1600607687920-4e2a09cf159d?auto=format&fit=crop&w=1200&q=85",
  },
  {
    slug: "real-estate-investment-basics",
    category: "سرمایه‌گذاری",
    title: "سه پرسش مهم پیش از سرمایه‌گذاری در بازار ملک",
    date: "۲ آبان ۱۴۰۵",
    readTime: "۴ دقیقه مطالعه",
    excerpt: "یک محتوای موقت برای دیدن چیدمان کارت‌ها؛ متن نهایی بعداً جایگزین می‌شود.",
    image: "https://images.unsplash.com/photo-1600566753086-00f18fb6b3ea?auto=format&fit=crop&w=1200&q=85",
  },
  {
    slug: "choosing-property-location",
    category: "راهنمای ملک",
    title: "چطور موقعیت یک ملک را دقیق‌تر ارزیابی کنیم؟",
    date: "۲۹ مهر ۱۴۰۵",
    readTime: "۵ دقیقه مطالعه",
    excerpt: "نمونه‌ای کوتاه برای نمایش متن توضیحی و اطلاعات هر مطلب در فهرست مقالات.",
    image: "https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?auto=format&fit=crop&w=1200&q=85",
  },
  {
    slug: "mashhad-market-review",
    category: "تحلیل بازار",
    title: "نگاهی کوتاه به تصمیم‌های مهم در بازار مسکن مشهد",
    date: "۲۶ مهر ۱۴۰۵",
    readTime: "۶ دقیقه مطالعه",
    excerpt: "یک خلاصه آزمایشی دیگر تا ظاهر صفحه اصلی با تعداد بیشتری مقاله بررسی شود.",
    image: "https://images.unsplash.com/photo-1600047509807-ba8f99d2cdde?auto=format&fit=crop&w=1200&q=85",
  },
];

---

<!doctype html>
<html lang="fa" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="مجله ملک؛ روایت بازار ملک، سرمایه‌گذاری و زندگی در مشهد."
    />
    <title>مجله ملک | بازار ملک و سرمایه‌گذاری در مشهد</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <header class="site-header">
      <div class="container header-inner">
  
      <a href="/" class="logo" aria-label="مجله ملک، مشهد">
        <span class="logo-name">مجله ملک</span>
        <span class="logo-location">مشهد</span>
      </a>

      <nav class="main-nav" aria-label="منوی اصلی">
        <a href="/">خانه</a>
        <a href="/articles">مقالات</a>
        <a href="/investment">سرمایه‌گذاری</a>
      </nav>

      <a href="/about" class="header-button">
        درباره ما
      </a>

    </div>
</header>

    <main>
      <section class="hero container" aria-labelledby="featured-title">
        <div class="hero-content">
          <div class="hero-kicker">
            <span class="hero-index" aria-hidden="true">01</span>
            <span class="eyebrow">{featuredArticle.category}</span>
            <span class="hero-kicker-line" aria-hidden="true"></span>
          </div>

          <p class="hero-overline">ویژه‌نامه مشهد <span>·</span> انتخاب سردبیر</p>
          <h1 id="featured-title">{featuredArticle.title}</h1>
          <p class="hero-excerpt">{featuredArticle.excerpt}</p>

          <div class="article-meta">
            <span>{featuredArticle.date}</span>
            <span class="meta-separator" aria-hidden="true"></span>
            <span>{featuredArticle.readTime}</span>
          </div>

          <div class="hero-actions">
            <a href="/articles/mashhad-investment" class="primary-button">
              مطالعه مقاله <span class="button-arrow" aria-hidden="true">←</span>
            </a>
            <a href="/articles" class="secondary-link">
              گشت‌وگذار در مقالات <span aria-hidden="true">↙</span>
            </a>
          </div>
        </div>

        <a href="/articles/mashhad-investment" class="hero-visual" aria-label="مطالعه مقاله منتخب سرمایه‌گذاری در مشهد">
          <img src={featuredArticle.image} alt="نمایی از یک خانه مدرن برای مقاله منتخب مجله ملک" fetchpriority="high" />
          <span class="hero-visual-shade" aria-hidden="true"></span>
          <span class="hero-visual-label">
            <span class="visual-label-mark" aria-hidden="true"></span>
            <span>نگاهی تازه به بازار مشهد</span>
          </span>
          <span class="hero-visual-number" aria-hidden="true">۰۱</span>
          <span class="hero-image-caption">تصویر منتخب · مجله ملک</span>
        </a>
      </section>

      <!-- INTRO -->
      <section class="intro container">
        <div class="section-label">مجله ملک</div>

        <div class="intro-text">
          <h2>
            روایت بازار ملک، سرمایه‌گذاری و زندگی در مشهد
          </h2>

          <p>
            ما در مجله ملک تلاش می‌کنیم مشهد را از زاویه‌ای متفاوت ببینیم؛
            از تحلیل بازار و راهنمای خرید تا نگاه دقیق‌تر
            به فرصت‌های سرمایه‌گذاری.
          </p>
        </div>
      </section>

      <!-- FEATURED ARTICLES -->
      <section class="stories container">
        <div class="section-heading">
          <span>مطالب منتخب</span>
          <a href="/articles">مشاهده همه مقالات ←</a>
        </div>

        <div class="stories-grid">
          <article class="story story-large">
            <div class="story-image">
              <img src={articles[0].image} alt={articles[0].title} />
            </div>

            <div class="story-content">
              <span class="eyebrow">{articles[0].category}</span>
              <h3>{articles[0].title}</h3>
              <p>{articles[0].excerpt}</p>
            </div>
          </article>

          <div class="stories-side">
            {
              articles.slice(1, 3).map((article) => (
                <article class="story-small">
                  <div class="small-image">
                    <img src={article.image} alt={article.title} loading="lazy" />
                  </div>

                  <div>
                    <span class="eyebrow">{article.category}</span>
                    <h3>{article.title}</h3>
                    <p>{article.excerpt}</p>
                    <time>{article.date}</time>
                  </div>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <!-- LATEST ARTICLES: image-free layout for this iteration -->
      <section class="latest-section" aria-labelledby="latest-title">
        <div class="container">
          <div class="section-heading latest-heading">
            <div>
              <span class="section-kicker">از تحریریه</span>
              <h2 id="latest-title">آخرین مطالب</h2>
            </div>
            <a href="/articles" class="archive-link">مشاهده همه مقالات <span aria-hidden="true">←</span></a>
          </div>

          <div class="latest-grid">
            {
              articles.map((article, index) => (
                <article class:list={["latest-card", index === 0 && "latest-card-lead"]}>
                  <div class="latest-card-top">
                    <span class="latest-number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
                    <span class="latest-category">{article.category}</span>
                  </div>

                  <div class="latest-content">
                    <h3><a href={`/articles/${article.slug}`}>{article.title}</a></h3>
                    <p>{article.excerpt}</p>
                  </div>

                  <div class="latest-card-bottom">
                    <div class="latest-meta">
                      <time>{article.date}</time>
                      <span class="latest-meta-dot" aria-hidden="true"></span>
                      <span>{article.readTime}</span>
                    </div>
                    <a class="latest-read-link" href={`/articles/${article.slug}`} aria-label={`مطالعه ${article.title}`}>
                      مطالعه <span aria-hidden="true">←</span>
                    </a>
                  </div>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <!-- CTA -->
      <section class="cta container">
        <div>
          <span class="section-label">مجله ملک</span>
          <h2>مشهد را بهتر بشناسید.</h2>
          <p>
            تحلیل‌ها و راهنماهای تازه درباره بازار ملک مشهد را دنبال کنید.
          </p>
        </div>

        <a href="/articles" class="primary-button">
          مشاهده مقالات
        </a>
      </section>
    </main>

    <footer class="site-footer">
      <div class="container footer-grid">
        <div>
          <div class="logo">مجله ملک</div>
          <p>
            روایت بازار ملک، سرمایه‌گذاری و زندگی در مشهد.
          </p>
        </div>

        <div class="footer-links">
          <a href="/articles">مقالات</a>
          <a href="/investment">سرمایه‌گذاری</a>
            <a href="/about">درباره ما</a>
        </div>
      </div>

      <div class="container footer-bottom">
        <span>© ۱۴۰۵ مجله ملک</span>
        <span>تمام حقوق محفوظ است.</span>
      </div>
    </footer>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    background: #183451;
    color: #f3ecde;
    font-family: "Vazirmatn", sans-serif;
    font-weight: 400;
  }

  :global(a) {
    color: inherit;
    text-decoration: none;
  }

  .container {
    width: min(1180px, calc(100% - 48px));
    margin-inline: auto;
  }

  .site-header {
    position: relative;
    z-index: 5;
    border-bottom: 1px solid rgba(243, 236, 222, 0.15);
    background: rgba(24, 52, 81, 0.96);
  }

  .header-inner {
    min-height: 88px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
  }

  .logo {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 3px;
    color: #d4af83;
    white-space: nowrap;
  }

  .logo-name {
    font-size: 1.35rem;
    line-height: 1.15;
    font-weight: 700;
  }

  .logo-location {
    color: rgba(243, 236, 222, 0.55);
    font-size: 0.65rem;
    font-weight: 400;
    letter-spacing: 0.12em;
  }

  .main-nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 30px;
    flex: 1;
  }

  .main-nav a {
    position: relative;
    color: rgba(243, 236, 222, 0.78);
    font-size: 0.88rem;
    transition: color 0.25s ease;
  }

  .main-nav a::after {
    content: "";
    position: absolute;
    right: 0;
    bottom: -8px;
    width: 0;
    height: 1px;
    background: #d4af83;
    transition: width 0.25s ease;
  }

  .main-nav a:hover { color: #d4af83; }
  .main-nav a:hover::after { width: 100%; }

  .header-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 10px 19px;
    background: #a9501c;
    color: #f3ecde;
    border: 1px solid #a9501c;
    border-radius: 4px;
    font-size: 0.82rem;
    font-weight: 600;
    transition: background 0.25s ease, transform 0.25s ease;
  }

  .header-button:hover {
    background: #8f4317;
    transform: translateY(-2px);
  }

  .hero {
    position: relative;
    min-height: min(760px, calc(100svh - 88px));
    display: grid;
    grid-template-columns: minmax(0, 1.06fr) minmax(0, 0.94fr);
    align-items: center;
    gap: clamp(35px, 5vw, 78px);
    padding-block: clamp(60px, 7vw, 100px);
    isolation: isolate;
  }

  .hero::before {
    content: "";
    position: absolute;
    z-index: -1;
    top: 8%;
    right: -3vw;
    width: 250px;
    height: 250px;
    border: 1px solid rgba(212, 175, 131, 0.08);
    border-radius: 50%;
    pointer-events: none;
  }

  .hero-content {
    grid-column: 1;
    grid-row: 1;
    position: relative;
    z-index: 2;
    padding-block: 25px;
  }

  .hero-kicker {
    display: flex;
    align-items: center;
    gap: 13px;
    margin-bottom: 28px;
  }

  .hero-index {
    color: rgba(212, 175, 131, 0.62);
    font-family: Georgia, serif;
    font-size: 0.9rem;
    letter-spacing: 0.08em;
  }

  .hero-kicker .eyebrow {
    margin: 0;
    color: #d4af83;
    font-size: 0.8rem;
  }

  .hero-kicker-line {
    display: block;
    width: 42px;
    height: 1px;
    background: rgba(212, 175, 131, 0.55);
  }

  .hero-overline {
    margin: 0 0 18px;
    color: rgba(243, 236, 222, 0.55);
    font-size: 0.78rem;
    letter-spacing: 0.02em;
  }

  .hero-overline span { padding-inline: 6px; color: #a9501c; }

  h1, h2, h3 {
    margin: 0;
    font-weight: 600;
    line-height: 1.45;
  }

  .hero h1 {
    max-width: 710px;
    color: #d4af83;
    font-size: clamp(2.65rem, 4.65vw, 5.15rem);
    line-height: 1.32;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  .hero-excerpt {
    max-width: 540px;
    margin: 27px 0 24px;
    color: rgba(243, 236, 222, 0.76);
    font-size: 1rem;
    line-height: 2.05;
  }

  .article-meta {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 30px;
    color: rgba(243, 236, 222, 0.54);
    font-size: 0.76rem;
  }

  .meta-separator {
    display: inline-block;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: #a9501c;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 24px;
  }

  .primary-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
    padding: 14px 20px;
    background: #a9501c;
    color: #f3ecde;
    border: 1px solid #a9501c;
    border-radius: 4px;
    font-size: 0.86rem;
    font-weight: 600;
    transition: transform 0.25s ease, background 0.25s ease, border-color 0.25s ease;
  }

  .button-arrow { display: inline-block; font-size: 1rem; transition: transform 0.25s ease; }
  .primary-button:hover { background: #8f4317; border-color: #8f4317; transform: translateY(-2px); }
  .primary-button:hover .button-arrow { transform: translateX(-3px); }

  .secondary-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: rgba(243, 236, 222, 0.73);
    font-size: 0.83rem;
    transition: color 0.25s ease;
  }

  .secondary-link span { color: #d4af83; font-size: 1rem; }
  .secondary-link:hover { color: #d4af83; }

  .hero-visual {
    grid-column: 2;
    grid-row: 1;
    position: relative;
    display: block;
    min-width: 0;
    height: clamp(430px, 43vw, 590px);
    overflow: hidden;
    background: #102b44;
    border: 1px solid rgba(212, 175, 131, 0.28);
    isolation: isolate;
  }

  .hero-visual::before {
    content: "";
    position: absolute;
    z-index: 2;
    inset: 12px;
    border: 1px solid rgba(243, 236, 222, 0.2);
    pointer-events: none;
  }

  .hero-visual img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .hero-visual:hover img { transform: scale(1.04); }

  .hero-visual-shade {
    position: absolute;
    z-index: 1;
    inset: 0;
    background: linear-gradient(180deg, rgba(16, 43, 68, 0.02) 45%, rgba(16, 43, 68, 0.7) 100%);
    pointer-events: none;
  }

  .hero-visual-label {
    position: absolute;
    z-index: 3;
    right: 32px;
    bottom: 32px;
    display: flex;
    align-items: center;
    gap: 10px;
    color: #f3ecde;
    font-size: 0.8rem;
  }

  .visual-label-mark { width: 7px; height: 7px; background: #d4af83; border-radius: 50%; }

  .hero-visual-number {
    position: absolute;
    z-index: 3;
    top: 28px;
    left: 30px;
    color: rgba(243, 236, 222, 0.88);
    font-family: Georgia, serif;
    font-size: 1.05rem;
    letter-spacing: 0.08em;
  }

  .hero-image-caption {
    position: absolute;
    z-index: 3;
    left: 30px;
    bottom: 32px;
    color: rgba(243, 236, 222, 0.68);
    font-size: 0.68rem;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
  }

  .story-image,
  .small-image,
  .latest-image {
    position: relative;
    overflow: hidden;
    background: #102b44;
  }

  .story-image img,
  .small-image img,
  .latest-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .story-image:hover img,
  .small-image:hover img,
  .latest-card:hover .latest-image img {
    transform: scale(1.035);
  }

  .latest-card {
    transition: transform 0.3s ease;
  }

  .latest-card:hover {
    transform: translateY(-5px);
  }

  .latest-image {
    aspect-ratio: 4 / 3;
    margin-bottom: 22px;
  }

  .image-placeholder {
    height: 100%;
    min-height: 540px;
    border: 1px solid rgba(212, 175, 131, 0.22);
  }

  .intro {
    display: grid;
    grid-template-columns: 0.4fr 1fr;
    gap: 80px;
    padding-block: 120px;
    border-top: 1px solid rgba(243, 236, 222, 0.14);
  }

  .intro h2 {
    max-width: 800px;
    color: #d4af83;
    font-size: clamp(2rem, 4vw, 3.8rem);
  }

  .intro p {
    max-width: 700px;
    margin-top: 28px;
    color: rgba(243, 236, 222, 0.72);
    font-size: 1rem;
    line-height: 2.1;
  }

  .section-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 42px;
    padding-bottom: 18px;
    border-bottom: 1px solid rgba(243, 236, 222, 0.14);
  }

  .section-heading > span {
    color: #d4af83;
    font-size: 1.3rem;
    font-weight: 600;
  }

  .section-heading a {
    color: rgba(243, 236, 222, 0.65);
    font-size: 0.82rem;

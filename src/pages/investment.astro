
---
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import "../styles/global.css";
import { articles } from "../data/articles.js";
import { formatJalali } from "../data/format-date.js";

const investmentArticles = articles.filter(
  (article) => article.category === "سرمایه‌گذاری"
);
---

<!doctype html>
<html lang="fa" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>مجله ملک؛ راهنمای سرمایه‌گذاری در بازار املاک مشهد، بررسی فرصت‌ها، شناخت محله‌ها و معیارهای انتخاب ملک مناسب برای سرمایه‌گذاری آگاهانه.</title>
    <meta
      name="description"
      content="راهنمای آشنایی با سرمایه‌گذاری ملکی در مشهد و معیارهای انتخاب ملک مناسب."
    />

	<link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fa_IR" />
    <meta property="og:site_name" content="مجله ملک" />
    <meta property="og:title" content="سرمایه‌گذاری در بازار ملک مشهد | مجله ملک" />
    <meta property="og:description" content="راهنمای آشنایی با سرمایه‌گذاری ملکی در مشهد و معیارهای انتخاب ملک مناسب." />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site).href} />
    <meta property="og:image" content={new URL("/images/hero-mashhad-shrine.jpg", Astro.site).href} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>

  <body>
    <SiteHeader active="investment" />

    <main>
      <section class="investment-hero">
        <div class="container">
          <span class="eyebrow">راهنمای سرمایه‌گذاری ملکی</span>
          <h1>نگاهی دقیق‌تر به فرصت‌های سرمایه‌گذاری در بازار ملک مشهد</h1>
          <p>
            با شناخت بازار، بررسی موقعیت ملک و آگاهی از معیارهای یک انتخاب
            مناسب، مسیر سرمایه‌گذاری ملکی را بهتر بشناسید.
          </p>
          <a href="/articles" class="primary-button">مطالعه مقالات</a>
        </div>
      </section>

      <section class="investment-intro section">
        <div class="container">
          <span class="eyebrow">شناخت بازار</span>
          <h2>چرا شناخت بازار ملک اهمیت دارد؟</h2>
          <p>
            تصمیم‌گیری در حوزه املاک به بررسی عوامل مختلفی مانند موقعیت،
            بودجه، نوع کاربری، شرایط معامله و نیازهای خریدار وابسته است.
            شناخت این عوامل می‌تواند به انتخاب آگاهانه‌تر کمک کند.
          </p>
        </div>
      </section>

      <section class="investment-factors section">
        <div class="container">
          <span class="eyebrow">معیارهای انتخاب</span>
          <h2>پیش از سرمایه‌گذاری به چه نکاتی توجه کنیم؟</h2>

          <div class="factor-grid">
            <article class="factor-card">
              <span>۰۱</span>
              <h3>موقعیت ملک</h3>
              <p>بررسی محله، دسترسی‌ها و امکانات اطراف ملک.</p>
            </article>

            <article class="factor-card">
              <span>۰۲</span>
              <h3>بودجه و هزینه‌ها</h3>
              <p>توجه به توان مالی و هزینه‌های جانبی معامله.</p>
            </article>

            <article class="factor-card">
              <span>۰۳</span>
              <h3>وضعیت حقوقی</h3>
              <p>بررسی سند، مدارک و شرایط قانونی ملک.</p>
            </article>

            <article class="factor-card">
              <span>۰۴</span>
              <h3>هدف سرمایه‌گذاری</h3>
              <p>مشخص کردن هدف خرید و مدت‌زمان موردنظر.</p>
            </article>
          </div>
        </div>
      </section>

      <section class="investment-articles section">
        <div class="container">
        <span class="eyebrow">مطالعه بیشتر</span>
        <h2>مقالات مرتبط با سرمایه‌گذاری</h2>
        <p>
          راهنماها و تحلیل‌های تخصصی برای شناخت بهتر فرصت‌ها و ریسک‌های بازار ملک مشهد.
        </p>

       <div class="investment-article-grid">
          {investmentArticles.map((article) => (
            <article class="investment-article-card">
            <span class="eyebrow">{article.category}</span>
              <h3>
                <a href={`/articles/${article.slug}`}>{article.title}</a>
              </h3>
            <p>{article.excerpt}</p>
            <div class="investment-article-meta">
              <span>{formatJalali(article.date)}</span>
              <span>{article.readTime} دقیقه مطالعه</span>
            </div>
            <a class="investment-read-link" href={`/articles/${article.slug}`}>
              مطالعه مقاله ←
            </a>
          </article>
        ))}
      </div>

      <a href="/articles" class="secondary-button">مشاهده همه مقالات</a>
      </div>
      </section>

      <section class="investment-cta">
        <div class="container">
          <h2>با آگاهی بیشتر تصمیم بگیرید</h2>
          <p>مجله ملک همراه شما در شناخت بازار املاک مشهد است.</p>
          <a href="/about" class="primary-button">درباره مجله ملک</a>
        </div>
      </section>
    </main>

    <SiteFooter />
  </body>
</html>

<style>
  :global(body) {
    margin: 0;
    background: #183451;
    color: #f3ecde;
    font-family: inherit;
  }

  .container {
    width: min(1180px, calc(100% - 48px));
    margin-inline: auto;
  }

  .section {
    padding-block: 90px;
  }

  .investment-hero {
    padding-block: 120px 130px;
    background: linear-gradient(135deg, #183451, #244968);
  }

  .investment-hero .container {
    max-width: 900px;
  }

  .eyebrow {
    color: #d4af83;
    font-size: 0.85rem;
  }

  h1 {
    max-width: 850px;
    margin: 22px 0;
    font-size: clamp(2rem, 5vw, 3.6rem);
    line-height: 1.8;
  }

  h2 {
    font-size: clamp(1.6rem, 3vw, 2.3rem);
    line-height: 1.8;
  }

  .investment-hero p,
  .investment-intro p,
  .investment-articles p {
    max-width: 760px;
    color: rgba(243, 236, 222, 0.72);
    font-size: 1.05rem;
    line-height: 2.2;
  }

  .primary-button,
  .secondary-button {
    display: inline-block;
    margin-top: 22px;
    padding: 12px 26px;
    border-radius: 8px;
    text-decoration: none;
    transition: 0.2s ease;
  }

  .primary-button {
    background: #a9501c;
    color: #fff;
  }

  .primary-button:hover {
    background: #c16a30;
  }

  .secondary-button {
    border: 1px solid #d4af83;
    color: #d4af83;
  }

  .investment-intro {
    border-bottom: 1px solid rgba(243, 236, 222, 0.12);
  }

  .investment-factors {
    background: rgba(255, 255, 255, 0.025);
  }

  .factor-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    margin-top: 42px;
  }

  .factor-card {
    padding: 30px;
    border: 1px solid rgba(243, 236, 222, 0.14);
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.035);
  }

  .factor-card span {
    color: #d4af83;
    font-size: 0.9rem;
  }

  .factor-card h3 {
    margin: 14px 0 8px;
    font-size: 1.2rem;
  }

  .factor-card p {
    color: rgba(243, 236, 222, 0.65);
    line-height: 2;
  }

  .investment-cta {
    padding-block: 75px;
    text-align: center;
    background: #203f5c;
  }

  .investment-cta p {
    color: rgba(243, 236, 222, 0.7);
    line-height: 2;
  }

  @media (max-width: 650px) {
    .investment-hero {
      padding-block: 80px;
    }

    .section {
      padding-block: 60px;
    }

    .factor-grid {
      grid-template-columns: 1fr;
    }

    .factor-card {
      padding: 24px;
    }
  }
.investment-article-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 20px;
  margin: 36px 0;
}

.investment-article-card {
  padding: 26px;
  background: #102B44;
  border: 1px solid rgba(243, 236, 222, 0.16);
  border-radius: 16px;
}

.investment-article-card h3 {
  color: #F3ECDE;
  line-height: 1.8;
  margin: 16px 0 10px;
}

.investment-article-card h3 a {
  color: inherit;
  text-decoration: none;
}

.investment-article-card p {
  color: #F3ECDE;
  line-height: 2;
}

.investment-article-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 16px;
  color: rgba(243, 236, 222, 0.72);
  font-size: 0.85rem;
  margin-top: 18px;
}

.investment-read-link {
  display: inline-block;
  margin-top: 18px;
  color: #D4AF83;
  text-decoration: none;
}
</style>

---
import SiteHeader from "../components/SiteHeader.astro";
import "../styles/global.css";
import { articles } from "../data/articles.js";
import SiteFooter from "../components/SiteFooter.astro";

const featuredArticle = articles.find((article) => article.homeFeatured);
---

<!doctype html>
<html lang="fa" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="مجله ملک؛ مطالب و راهنماهای بازار مسکن مشهد، خرید ملک و سرمایه‌گذاری آگاهانه در بازار املاک مشهد."
    />
    <meta name="theme-color" content="#183451" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fa_IR" />
    <meta property="og:site_name" content="مجله ملک" />
    <meta property="og:title" content="مجله ملک | بازار ملک و سرمایه‌گذاری در مشهد" />
    <meta
      property="og:description"
      content="روایت بازار ملک، راهنمای خرید و نگاه دقیق‌تر به سرمایه‌گذاری در مشهد."
    />
    <title>مجله ملک | بازار ملک و سرمایه‌گذاری در مشهد</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  </head>

  <body>
    <a class="skip-link" href="#main-content">رفتن به محتوای اصلی</a>
    <SiteHeader active="home" />

    <main id="main-content">
      <section class="hero container" aria-labelledby="featured-title">
        <div class="hero-content">
          <div class="hero-kicker">
            <span class="hero-index" aria-hidden="true">01</span>
            <span class="eyebrow">{featuredArticle.category}</span>
            <span class="hero-kicker-line" aria-hidden="true"></span>
          </div>

          <p class="hero-overline">ویژه‌نامه مشهد <span>·</span> انتخاب سردبیر</p>
          <h1 id="featured-title">{featuredArticle.title}</h1>
          <p class="hero-excerpt">{featuredArticle.excerpt}</p>

          <div class="article-meta">
            <span>{featuredArticle.date}</span>
            <span class="meta-separator" aria-hidden="true"></span>
            <span>{featuredArticle.readTime}</span>
          </div>

          <div class="hero-actions">
            <a href={`/articles/${featuredArticle.slug}`} class="primary-button">
              مطالعه مقاله <span class="button-arrow" aria-hidden="true">←</span>
            </a>
            <a href="/articles" class="secondary-link">
              گشت‌وگذار در مقالات <span aria-hidden="true">↙</span>
            </a>
          </div>
        </div>

<div class="hero-visual" role="img" aria-label="نمای هوایی حرم مطهر امام رضا در مشهد">
  <img
    src="/images/hero-mashhad-shrine.jpg"
    alt="نمای هوایی حرم مطهر امام رضا در مشهد"
    class="hero-image"
    fetchpriority="high"
  />
  <span class="hero-visual-shade" aria-hidden="true"></span>
  <span class="hero-visual-number" aria-hidden="true">۰۱</span>
  <span class="hero-visual-label">
    <span class="hero-visual-label-top">مشهد مقدس</span>
    <span class="hero-visual-label-main">حرم امام رضا (ع)</span>
  </span>
  <span class="hero-image-caption">نمای هوایی حرم مطهر رضوی</span>
</div>        
      </section>

      <!-- INTRO -->
      <section class="intro container">
        <div class="section-label">مجله ملک</div>

        <div class="intro-text">
          <h2>
            روایت بازار ملک، سرمایه‌گذاری و زندگی در مشهد
          </h2>

          <p>
            ما در مجله ملک تلاش می‌کنیم مشهد را از زاویه‌ای متفاوت ببینیم؛
            از تحلیل بازار و راهنمای خرید تا نگاه دقیق‌تر
            به فرصت‌های سرمایه‌گذاری.
          </p>
        </div>
      </section>

      <!-- FEATURED ARTICLES -->
      <section class="stories container">
        <div class="section-heading">
          <span>مطالب منتخب</span>
          <a href="/articles">مشاهده همه مقالات ←</a>
        </div>

        <div class="stories-grid">
          <article class="story story-large">
            <div class="story-image media-placeholder" role="img" aria-label="جایگاه تصویر مقاله منتخب">
              <span class="placeholder-glyph" aria-hidden="true">▧</span>
              <span>تصویر مقاله</span>
            </div>

            <div class="story-content">
              <span class="eyebrow">{articles[0].category}</span>
              <h3><a href={`/articles/${articles[0].slug}`}>{articles[0].title}</a></h3>
              <p>{articles[0].excerpt}</p>
              <a class="story-read-link" href={`/articles/${articles[0].slug}`}>مطالعه مقاله <span aria-hidden="true">←</span></a>
            </div>
          </article>

          <div class="stories-side">
            {
              articles.slice(1, 3).map((article) => (
                <article class="story-small">
                  <div class="small-image media-placeholder" role="img" aria-label="جایگاه تصویر مقاله">
                    <span class="placeholder-glyph" aria-hidden="true">▧</span>
                  </div>

                  <div>
                    <span class="eyebrow">{article.category}</span>
                    <h3><a href={`/articles/${article.slug}`}>{article.title}</a></h3>
                    <p>{article.excerpt}</p>
                    <time>{article.date}</time>
                    <a class="story-read-link" href={`/articles/${article.slug}`}>مطالعه مقاله <span aria-hidden="true">←</span></a>
                  </div>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <!-- LATEST ARTICLES: editorial text-first layout; photos will be added later -->
      <section class="latest-section" aria-labelledby="latest-title">
        <div class="container">
          <div class="section-heading latest-heading">
            <div>
              <span class="section-kicker">از تحریریه</span>
              <h2 id="latest-title">آخرین مطالب</h2>
            </div>
            <a href="/articles" class="archive-link">مشاهده همه مقالات <span aria-hidden="true">←</span></a>
          </div>

          <div class="latest-grid">
            {
              articles.map((article, index) => (
                <article class:list={["latest-card", index === 0 && "latest-card-lead"]}>
                  <div class="latest-card-top">
                    <span class="latest-number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
                    <span class="latest-category">{article.category}</span>
                  </div>

                  <div class="latest-content">
                    <h3><a href={`/articles/${article.slug}`}>{article.title}</a></h3>
                    <p>{article.excerpt}</p>
                  </div>

                  <div class="latest-card-bottom">
                    <div class="latest-meta">
                      <time>{article.date}</time>
                      <span class="latest-meta-dot" aria-hidden="true"></span>
                      <span>{article.readTime}</span>
                    </div>
                    <a class="latest-read-link" href={`/articles/${article.slug}`} aria-label={`مطالعه ${article.title}`}>
                      مطالعه <span aria-hidden="true">←</span>
                    </a>
                  </div>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <!-- EDITORIAL FOCUS -->
      <section class="editorial-focus container" aria-labelledby="focus-title">
        <div class="focus-heading">
          <span class="section-kicker">مسیرهای مطالعه</span>
          <h2 id="focus-title">از کجا شروع کنیم؟</h2>
          <p>سه زاویه برای شناخت بهتر بازار ملک مشهد؛ محتوای این بخش در مرحله بعد با مقاله‌های واقعی تکمیل می‌شود.</p>
        </div>

        <div class="focus-list">
          <a class="focus-item" href="/articles">
            <span class="focus-index">۰۱</span>
            <span class="focus-copy">
              <strong>شناخت بازار</strong>
              <span>روندها، عوامل اثرگذار و تصویر کلی بازار مسکن مشهد</span>
            </span>
            <span class="focus-arrow" aria-hidden="true">←</span>
          </a>
          <a class="focus-item" href="/articles">
            <span class="focus-index">۰۲</span>
            <span class="focus-copy">
              <strong>تصمیم برای خرید</strong>
              <span>نکته‌هایی برای بررسی، مقایسه و تصمیم‌گیری آگاهانه</span>
            </span>
            <span class="focus-arrow" aria-hidden="true">←</span>
          </a>
          <a class="focus-item" href="/investment">
            <span class="focus-index">۰۳</span>
            <span class="focus-copy">
              <strong>نگاه سرمایه‌گذاری</strong>
              <span>ارزیابی فرصت‌ها، شناخت ریسک‌ها و برنامه‌ریزی بلندمدت</span>
            </span>
            <span class="focus-arrow" aria-hidden="true">←</span>
          </a>
        </div>
      </section>

      <!-- CTA -->
      <section class="cta container">
        <div>
          <span class="section-label">مجله ملک</span>
          <h2>مشهد را بهتر بشناسید.</h2>
          <p>
            تحلیل‌ها و راهنماهای تازه درباره بازار ملک مشهد را دنبال کنید.
          </p>
        </div>

        <a href="/articles" class="primary-button">
          مشاهده مقالات
        </a>
      </section>
    </main>
  <SiteFooter />
  </body>
</html>

<style>
  :global(body) {
    background-color: #183451;
  }
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    background: #183451;
    color: #f3ecde;
    font-family: "Vazirmatn", sans-serif;
    font-weight: 400;
  }

  :global(a) {
    color: inherit;
    text-decoration: none;
  }

  :global(a:focus-visible),
  :global(button:focus-visible),
  :global(summary:focus-visible) {
    outline: 2px solid #d4af83;
    outline-offset: 4px;
  }

  .skip-link {
    position: absolute;
    z-index: 100;
    top: 10px;
    right: 10px;
    padding: 10px 14px;
    color: #183451;
    background: #f3ecde;
    transform: translateY(-160%);
    transition: transform 0.2s ease;
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  .container {
    width: min(1180px, calc(100% - 48px));
    margin-inline: auto;
  }

  .site-header {
    position: relative;
    z-index: 5;
    border-bottom: 1px solid rgba(243, 236, 222, 0.15);
    background: rgba(24, 52, 81, 0.96);
  }

  .header-inner {
    min-height: 88px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
  }

  .logo {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 3px;
    color: #d4af83;
    white-space: nowrap;
  }

  .logo-name {
    font-size: 1.35rem;
    line-height: 1.15;
    font-weight: 700;
  }

  .logo-location {
    color: rgba(243, 236, 222, 0.55);
    font-size: 0.65rem;
    font-weight: 400;
    letter-spacing: 0.12em;
  }

  .main-nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 30px;
    flex: 1;
  }

  .main-nav a {
    position: relative;
    color: rgba(243, 236, 222, 0.78);
    font-size: 0.88rem;
    transition: color 0.25s ease;
  }

  .main-nav a::after {
    content: "";
    position: absolute;
    right: 0;
    bottom: -8px;
    width: 0;
    height: 1px;
    background: #d4af83;
    transition: width 0.25s ease;
  }

  .main-nav a:hover { color: #d4af83; }
  .main-nav a:hover::after { width: 100%; }

  .mobile-menu { display: none; }

  .header-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 10px 19px;
    background: #a9501c;
    color: #f3ecde;
    border: 1px solid #a9501c;
    border-radius: 4px;
    font-size: 0.82rem;
    font-weight: 600;
    transition: background 0.25s ease, transform 0.25s ease;
  }

  .header-button:hover {
    background: #8f4317;
    transform: translateY(-2px);
  }

  .hero {
    position: relative;
    min-height: min(820px, calc(100svh - 88px));
    display: grid;
    grid-template-columns: minmax(0, 1.06fr) minmax(0, 0.94fr);
    align-items: center;
    gap: clamp(35px, 5vw, 78px);
    padding-block: clamp(60px, 7vw, 100px);
    isolation: isolate;
  }

  .hero::before {
    content: "";
    position: absolute;
    z-index: -1;
    top: 8%;
    right: -3vw;
    width: 250px;
    height: 250px;
    border: 1px solid rgba(212, 175, 131, 0.08);
    border-radius: 50%;
    pointer-events: none;
  }

  .hero-content {
    grid-column: 1;
    grid-row: 1;
    position: relative;
    z-index: 2;
    padding-block: 25px;
  }

  .hero-kicker {
    display: flex;
    align-items: center;
    gap: 13px;
    margin-bottom: 28px;
  }

  .hero-index {
    color: #a9501c;
    font-family: Georgia, serif;
    font-size: 0.9rem;
    letter-spacing: 0.08em;
  }

  .hero-kicker .eyebrow {
    margin: 0;
    color: #d4af83;
    font-size: 0.8rem;
  }

  .hero-kicker-line {
    display: block;
    width: 42px;
    height: 1px;
    background: rgba(212, 175, 131, 0.55);
  }

  .hero-overline {
    margin: 0 0 18px;
    color: rgba(243, 236, 222, 0.55);
    font-size: 0.78rem;
    letter-spacing: 0.02em;
  }

  .hero-overline span { padding-inline: 6px; color: #a9501c; }

  h1, h2, h3 {
    margin: 0;
    font-weight: 600;
    line-height: 1.45;
  }

  .hero h1 {
    max-width: 710px;
    color: #d4af83;
    font-size: clamp(2.65rem, 4.65vw, 5.15rem);
    line-height: 1.32;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  .hero-excerpt {
    max-width: 540px;
    margin: 27px 0 24px;
    color: rgba(243, 236, 222, 0.76);
    font-size: 1rem;
    line-height: 2.05;
  }

  .article-meta {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 30px;
    color: rgba(24, 52, 81, 0.78);
    font-size: 0.76rem;
  }

  .meta-separator {
    display: inline-block;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: #a9501c;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 24px;
  }

  .primary-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
    padding: 14px 20px;
    background: #a9501c;
    color: #f3ecde;
    border: 1px solid #a9501c;
    border-radius: 4px;
    font-size: 0.86rem;
    font-weight: 600;
    transition: transform 0.25s ease, background 0.25s ease, border-color 0.25s ease;
  }

  .button-arrow { display: inline-block; font-size: 1rem; transition: transform 0.25s ease; }
  .primary-button:hover { background: #8f4317; border-color: #8f4317; transform: translateY(-2px); }
  .primary-button:hover .button-arrow { transform: translateX(-3px); }

  .secondary-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: rgba(243, 236, 222, 0.73);
    font-size: 0.83rem;
    transition: color 0.25s ease;
  }

  .secondary-link span { color: #d4af83; font-size: 1rem; }
  .secondary-link:hover { color: #d4af83; }

  .hero-visual {
    grid-column: 2;
    grid-row: 1;
    position: relative;
    display: block;
    min-width: 0;
    height: clamp(520px, 48vw, 680px);
    overflow: hidden;
    background: #102b44;
    border: 1px solid rgba(212, 175, 131, 0.28);
    isolation: isolate;
  }

  .hero-visual::before {
    content: "";
    position: absolute;
    z-index: 2;
    inset: 12px;
    border: 1px solid rgba(243, 236, 222, 0.2);
    pointer-events: none;
  }

  .hero-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    margin: auto;
  }
  }
  .hero-visual-placeholder {
    background:
    radial-gradient(circle at 25% 22%, rgba(212, 175, 131, 0.12), transparent 34%),
    repeating-linear-gradient(135deg, rgba(24, 52, 81, 0.035) 0 1px, transparent 1px 18px),
    #F3ECDE;
  }

  .placeholder-architecture {
    position: absolute;
    display: block;
    border: 1px solid rgba(212, 175, 131, 0.28);
    pointer-events: none;
  }

  .architecture-one {
    width: 58%;
    height: 62%;
    top: 17%;
    right: 18%;
    border-bottom: 0;
    transform: skewY(-5deg);
  }

  .architecture-two {
    width: 38%;
    height: 42%;
    top: 32%;
    right: 31%;
    border-bottom: 0;
    border-color: rgba(243, 236, 222, 0.18);
    transform: skewY(7deg);
  }

  .hero-visual-placeholder .hero-visual-shade {
    background: linear-gradient(180deg, transparent 30%, rgba(16, 43, 68, 0.76) 100%);
  }

  .hero-visual-shade {
    position: absolute;
    z-index: 1;
    inset: 0;
    background: linear-gradient(180deg, rgba(16, 43, 68, 0.02) 45%, rgba(16, 43, 68, 0.7) 100%);
    pointer-events: none;
  }

  .hero-visual-label {
    position: absolute;
    z-index: 3;
    right: 32px;
    bottom: 32px;
    display: flex;
    align-items: center;
    gap: 10px;
    color: #f3ecde;
    font-size: 0.8rem;
  }

  .visual-label-mark { width: 7px; height: 7px; background: #d4af83; border-radius: 50%; }

  .hero-visual-number {
    position: absolute;
    z-index: 3;
    top: 28px;
    left: 30px;
    color: rgba(243, 236, 222, 0.88);
    font-family: Georgia, serif;
    font-size: 1.05rem;
    letter-spacing: 0.08em;
  }

  .hero-image-caption {
    position: absolute;
    z-index: 3;
    left: 30px;
    bottom: 32px;
    color: rgba(243, 236, 222, 0.68);
    font-size: 0.68rem;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
  }

  .story-image,
  .small-image,
  .latest-image {
    position: relative;
    overflow: hidden;
    background: #102b44;
  }

  .media-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    color: rgba(24, 52, 81, 0.72);
    border: 1px solid rgba(212, 175, 131, 0.14);
    background:
      radial-gradient(circle at 75% 20%, rgba(212, 175, 131, 0.09), transparent 35%),
      repeating-linear-gradient(135deg, rgba(243, 236, 222, 0.025) 0 1px, transparent 1px 15px),
      #102b44;
    font-size: 0.76rem;
  }

  .placeholder-glyph {
    color: rgba(212, 175, 131, 0.72);
    font-size: 1.15rem;
  }

  .latest-card {
    transition: transform 0.3s ease;
  }

  .latest-card:hover {
    transform: translateY(-3px);
  }

  .latest-image {
    aspect-ratio: 4 / 3;
    margin-bottom: 22px;
  }

  .image-placeholder {
    height: 100%;
    min-height: 540px;
    border: 1px solid rgba(212, 175, 131, 0.22);
  }

  .intro {
    display: grid;
    grid-template-columns: 0.4fr 1fr;
    gap: 80px;
    padding-block: 120px;
    border-top: 1px solid rgba(243, 236, 222, 0.14);
  }

  .intro h2 {
    max-width: 800px;
    color: #d4af83;
    font-size: clamp(2rem, 4vw, 3.8rem);
  }

  .intro p {
    max-width: 700px;
    margin-top: 28px;
    color: rgba(243, 236, 222, 0.72);
    font-size: 1rem;
    line-height: 2.1;
  }

  .section-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 42px;
    padding-bottom: 18px;
    border-bottom: 1px solid rgba(243, 236, 222, 0.14);
  }

  .section-heading > span {
    color: #d4af83;
    font-size: 1.3rem;
    font-weight: 600;
  }

  .section-heading a {
    color: rgba(243, 236, 222, 0.65);
    font-size: 0.82rem;
  }

  .stories {
    padding-block: 60px 120px;
  }

  .stories-grid {
    display: grid;
    grid-template-columns: 1.35fr 0.65fr;
    gap: 45px;
  }

  .story-image {
    aspect-ratio: 16 / 9;
    margin-bottom: 25px;
  }

  .story-content h3 {
    color: #d4af83;
    font-size: clamp(1.6rem, 3vw, 2.6rem);
    transition: color 0.25s ease;
  }

  .story-content h3 a:hover,
  .story-small h3 a:hover {
    color: #f3ecde;
  }

  .story-read-link {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    margin-top: 13px;
    color: #d4af83;
    font-size: 0.78rem;
    transition: color 0.2s ease;
  }

  .story-read-link span {
    display: inline-block;
    transition: transform 0.2s ease;
  }


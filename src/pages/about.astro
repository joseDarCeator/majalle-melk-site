---
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import "../styles/global.css";

const certificates = [
  {
    title: "مشاوره خرید و فروش املاک در اینترنت",
    institute:
      "سازمان آموزش فنی و حرفه‌ای کشور، وزارت تعاون، کار و رفاه اجتماعی",
    year: "۱۴۰۳",
    duration: "۹۰ ساعت",
    score: "۸۲ از ۱۰۰ — سطح خیلی خوب",
    serial: "40902265",
    label: "شماره گواهینامه",
    description:
      "گواهینامه دولتی و قابل استعلام در حوزه مشاوره خرید و فروش املاک در اینترنت.",
  },
  {
    title: "مدیریت املاک",
    institute: "OZ AVSARLAR LTD (OVS) — ترکیه",
    year: "۲۰۲۰",
    duration: "۱۲۰ ساعت",
    score: null,
    serial: "152760",
    label: "شماره مدرک",
    description:
      "دوره تخصصی مدیریت املاک با نگاه بین‌المللی.",
  },
  {
    title: "داوری حقوقی",
    institute: "موسسه آموزش عالی آزاد امین",
    year: "۱۴۰۱",
    duration: "۵۰ ساعت",
    score: "۱۹ از ۲۰ — عالی",
    serial: "1610306",
    label: "شماره سریال",
    description:
      "آموزش داوری حقوقی؛ با تمرکز بر اهمیت امنیت قراردادها.",
  },
  {
    title: "مشاور حقوقی املاک",
    institute: "موسسه آموزش عالی آزاد امین",
    year: "۱۴۰۱",
    duration: "۵۰ ساعت",
    score: "۱۹ از ۲۰ — عالی",
    serial: "1610305",
    label: "شماره سریال",
    description:
      "تخصص تکمیلی در حوزه مسائل حقوقی معاملات املاک.",
  },
  {
    title: "مدیریت و مشاور فروش ساختمان",
    institute: "موسسه آموزش عالی آزاد امین",
    year: "۱۴۰۱",
    duration: "۵۰ ساعت",
    score: "۱۹ از ۲۰ — عالی",
    serial: "1610307",
    label: "شماره سریال",
    description:
      "دوره مرتبط با مدیریت و مشاوره فروش ساختمان و فعالیت بوتیک ملک.",
  },
];
---

<!doctype html>
<html lang="fa" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>درباره محمد صادقی | مجله ملک</title>
    <meta
      name="description"
      content="آشنایی با محمد صادقی، مشاور املاک در مشهد و بنیانگذار بوتیک ملک و مجله ملک؛ همراه با سوابق آموزشی و حرفه‌ای."
    />
  </head>

  <body>
    <SiteHeader />

    <main class="about-page">

      <!-- معرفی نویسنده -->
      <section class="author-section">
        <div class="author-photo">
          <img
             src="/images/mohamad-sadeghi.webp"
             alt="محمد صادقی، مشاور املاک در مشهد"
          />
        </div>

        <div class="author-content">
          <span class="eyebrow">بنیانگذار بوتیک ملک و مجله ملک</span>

          <h1>درباره محمد صادقی</h1>

          <h2>
            مشاور املاک در مشهد | بنیانگذار بوتیک ملک و مجله ملک
          </h2>

          <div class="author-divider"></div>

          <p>
            من محمد صادقی‌ام، مشاور املاک در مشهد و بنیانگذار بوتیک ملک و مجله ملک.
            مسیر من از فروش شروع شد، به حقوق قرارداد رسید و بعد به سرمایه‌گذاری.
            دوره مدیریت و مشاور فروش ساختمان را گذراندم، دوره مشاور حقوقی املاک
            و داوری حقوقی را خواندم، دوره ۱۲۰ ساعته مدیریت املاک در ترکیه را
            تمام کردم و گواهینامه مهارت فنی‌حرفه‌ای مشاوره خرید و فروش املاک در
            اینترنت را با نمره خیلی خوب گرفتم. بوتیک ملک کار من است؛ جایی برای
            دیدن ملک‌های منتخب. مجله ملک اسم من است؛ جایی که چیزی برای فروش ندارم
            و فقط درباره خرید امن و سرمایه‌گذاری در مشهد می‌نویسم.
          </p>
        </div>
      </section>

      <!-- مدارک و سوابق -->
      <section class="certificates-section">
        <div class="section-heading">
          <span class="eyebrow">مسیر تخصص و یادگیری</span>
          <h2>سوابق آموزشی و حرفه‌ای</h2>
          <p>
            پنج مدرک و دوره آموزشی در حوزه املاک، مدیریت، فروش و حقوق قراردادها
          </p>
        </div>

        <div class="certificates-grid">
          {certificates.map((certificate, index) => (
            <article class="certificate-card">
              <div class="certificate-placeholder">
                <span>جای اسکن مدرک — به‌زودی</span>
              </div>

              <div class="certificate-content">
                <span class="certificate-index">
                  مدرک {String(index + 1).padStart(2, "0")}
                </span>

                <h3>{certificate.title}</h3>

                <p class="certificate-institute">
                  {certificate.institute}
                </p>

                <div class="certificate-divider"></div>

                <div class="certificate-info">
                  <div>
                    <span>سال</span>
                    <strong>{certificate.year}</strong>
                  </div>

                  <div>
                    <span>مدت دوره</span>
                    <strong>{certificate.duration}</strong>
                  </div>

                  {certificate.score && (
                    <div>
                      <span>نمره</span>
                      <strong>{certificate.score}</strong>
                    </div>
                  )}

                  <div>
                    <span>{certificate.label}</span>
                    <strong>{certificate.serial}</strong>
                  </div>
                </div>

                <p class="certificate-description">
                  {certificate.description}
                </p>
              </div>
            </article>
          ))}
        </div>
      </section>

      <!-- معرفی مجله -->
      <section class="magazine-section">
        <span class="eyebrow">مجله ملک</span>

        <h2>روایت بازار ملک و سرمایه‌گذاری در مشهد</h2>

        <p>
          مجله ملک فضایی برای انتشار راهنماها و تحلیل‌های بازار املاک مشهد است؛
          جایی برای شناخت بهتر بازار، بررسی جنبه‌های حقوقی و اقتصادی معاملات
          و تصمیم‌گیری آگاهانه در خرید و سرمایه‌گذاری.
        </p>
      </section>

      <!-- دعوت به بوتیک ملک -->
      <section class="boutik-cta">
        <span>بوتیک ملک</span>

        <h2>برای مشاهده ملک‌های منتخب به بوتیک ملک بروید.</h2>

        <a
          href="https://boutikmelk.ir"
          target="_blank"
          rel="noopener noreferrer"
        >
          مشاهده در بوتیک ملک
        </a>
      </section>

    </main>

    <SiteFooter />
  </body>
</html>

<style>
  :global(body) {
    background: #183451;
  }
  .about-page {
    width: min(1120px, 92%);
    margin-inline: auto;
    padding: 65px 0 80px;
    color: #F3ECDE;
  }

  /* معرفی محمد صادقی */

  .author-section {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    align-items: center;
    gap: 55px;
    margin-bottom: 110px;
  }

  .author-photo {
  height: 650px;
  overflow: hidden;
  border: 1px solid rgba(212, 175, 131, 0.45);
  border-radius: 18px;
  background: rgba(243, 236, 222, 0.045);
  }

  .author-photo img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: center 30%;
  }

  .eyebrow {
    display: inline-block;
    margin-bottom: 14px;
    color: #D4AF83;
    font-size: 14px;
    font-weight: 600;
  }

  .author-content h1 {
    margin: 0 0 12px;
    color: #D4AF83;
    font-size: clamp(30px, 4vw, 42px);
    line-height: 1.7;
  }

  .author-content h2 {
    margin: 0;
    color: #F3ECDE;
    font-size: 17px;
    font-weight: 500;
    line-height: 2;
  }

  .author-divider,
  .certificate-divider {
    height: 1px;
    background: rgba(243, 236, 222, 0.16);
  }

  .author-divider {
    margin: 25px 0;
  }

  .author-content p {
    margin: 0;
    color: rgba(243, 236, 222, 0.88);
    font-size: 15px;
    line-height: 2.65;
    text-align: justify;
  }

  /* سوابق آموزشی */

  .certificates-section {
    margin-bottom: 100px;
  }

  .section-heading {
    text-align: center;
    margin-bottom: 42px;
  }

  .section-heading h2,
  .magazine-section h2 {
    margin: 0 0 12px;
    color: #D4AF83;
    font-size: clamp(24px, 3vw, 32px);
    line-height: 1.8;
  }

  .section-heading p {
    margin: 0;
    color: rgba(243, 236, 222, 0.78);
    font-size: 14px;
    line-height: 2.2;
  }

  .certificates-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 25px;
  }

  .certificate-card {
    overflow: hidden;
    border: 1px solid rgba(212, 175, 131, 0.22);
    border-radius: 16px;
    background: #102B44;
    transition:
      transform 0.25s ease,
      border-color 0.25s ease;
  }

  .certificate-card:hover {
    transform: translateY(-4px);
    border-color: rgba(212, 175, 131, 0.65);
  }

  .certificate-placeholder {
    min-height: 190px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #343D47;
    border-bottom: 1px solid rgba(243, 236, 222, 0.13);
    color: #E0E0E0;
    font-size: 14px;
  }

  .certificate-content {
    padding: 25px;
  }

  .certificate-index {
    color: #D4AF83;
    font-size: 12px;
  }

  .certificate-content h3 {
    margin: 9px 0 12px;
    color: #F3ECDE;
    font-size: 19px;
    line-height: 1.9;
  }

  .certificate-institute {
    min-height: 55px;
    margin: 0;
    color: rgba(243, 236, 222, 0.78);
    font-size: 13px;
    line-height: 2;
  }

  .certificate-divider {
    margin: 18px 0;
  }

  .certificate-info {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px 15px;
  }

  .certificate-info div {
    display: flex;
    flex-direction: column;
    gap: 7px;
  }

  .certificate-info span {
    color: #D4AF83;
    font-size: 12px;
  }

  .certificate-info strong {
    color: #F3ECDE;
    font-size: 13px;
    line-height: 1.9;
    overflow-wrap: anywhere;
  }

  .certificate-description {
    margin: 22px 0 0;
    padding-top: 16px;
    border-top: 1px solid rgba(243, 236, 222, 0.12);
    color: rgba(243, 236, 222, 0.82);
    font-size: 13px;
    line-height: 2.2;
  }

  /* معرفی مجله */

  .magazine-section {
    padding: 38px 42px;
    margin-bottom: 65px;
    border-right: 3px solid #D4AF83;
    background: rgba(243, 236, 222, 0.045);
    border-radius: 12px;
  }

  .magazine-section p {
    margin: 12px 0 0;
    color: rgba(243, 236, 222, 0.86);
    font-size: 15px;
    line-height: 2.5;
    text-align: justify;
  }

  /* باکس پایانی */

  .boutik-cta {
    padding: 45px 25px;
    border: 1px solid rgba(212, 175, 131, 0.55);
    border-radius: 18px;
    background: #D4AF83;
    color: #183451 !important;
    text-align: center;
  }

  .boutik-cta > span {
    display: block;
    margin-bottom: 10px;
    color: #183451;
    font-size: 14px;
    font-weight: 700;
  }

  .boutik-cta h2 {
    margin: 0 0 25px;
    color: #183451;
    font-size: clamp(20px, 3vw, 25px);
    line-height: 1.9;
  }

  .boutik-cta a {
    display: inline-block;
    padding: 13px 30px;
    border-radius: 8px;
    background: #A9501C;
    color: #F3ECDE;
    font-size: 14px;
    text-decoration: none;
    transition: background 0.2s ease;
  }

  .boutik-cta a:hover {
    background: #8F4317;
  }

  /* نسخه موبایل */

  @media (max-width: 768px) {
    .about-page {
      padding: 40px 0 55px;
    }

    .author-section {
      grid-template-columns: 1fr;
      gap: 28px;
      margin-bottom: 75px;
    }

    .author-photo {
      min-height: 300px;
    }

    .author-content p {
      font-size: 14px;
      line-height: 2.4;
    }

    .certificates-section {
      margin-bottom: 75px;
    }

    .certificates-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .certificate-placeholder {
      min-height: 165px;
    }

    .magazine-section {
      padding: 28px 22px;
      margin-bottom: 45px;
    }

    .magazine-section p {
      font-size: 14px;
    }

    .boutik-cta {
      padding: 32px 20px;
    }
  }
</style>
